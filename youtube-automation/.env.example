# === xAI (Grok) - 이미지 생성 ===
# https://docs.x.ai/developers/model-capabilities/images/generation
XAI_API_KEY=

# === ElevenLabs - 나레이션(TTS) ===
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# === Higgsfield - 이미지→영상 / 이미지 애니메이션 ===
# 대시보드에서 발급받은 키와, 대시보드 코드 예제에 나온 실제 엔드포인트로 맞춰주세요.
# (lib/higgsfield.mjs 상단 주석 참고 - 이 파일만 계정 스펙에 맞게 검증/수정하면 됩니다)
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE=https://api.higgsfield.ai

# === 영상 출력 설정 ===
# 16:9 또는 9:16
VIDEO_ASPECT=16:9
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080

# 대본 중 앞에서부터 몇 섹션을 "영상"으로 만들지 (나머지는 정적 이미지 애니메이션)
VIDEO_SECTION_COUNT=3
